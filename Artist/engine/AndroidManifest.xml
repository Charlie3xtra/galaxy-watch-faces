<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.artist.watchface" android:versionCode="9" android:versionName="4.4">
 <queries><intent><action android:name="com.google.wear.ACTION_PUSH_WATCH_FACES"/></intent><package android:name="com.google.android.wearable.app"/></queries>
 <uses-feature android:name="android.hardware.type.watch" android:required="true"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
 <uses-permission android:name="com.google.wear.permission.PUSH_WATCH_FACES"/>
 <uses-permission android:name="com.google.wear.permission.SET_PUSHED_WATCH_FACE_AS_ACTIVE"/>
 <application android:name="local.artist.engine.ArtistApp" android:label="@string/face_name" android:icon="@drawable/preview" android:allowBackup="false" android:supportsRtl="true">
  <meta-data android:name="com.google.android.wearable.standalone" android:value="true"/>
  <uses-library android:name="wear-sdk" android:required="true"/>
  <activity android:name="local.artist.engine.WakeSettings" android:exported="true" android:theme="@android:style/Theme.Material.NoActionBar">
  </activity>
  <activity-alias android:name="local.artist.engine.LocalizedSetupLauncher" android:targetActivity="local.artist.engine.WakeSettings" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity-alias>
  <service android:name="local.artist.engine.WakeListener" android:foregroundServiceType="specialUse" android:exported="false">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="User-enabled watch-face wake transitions when the portrait has expired. No wake locks or polling."/>
  </service>
  <receiver android:name="local.artist.engine.Tap" android:exported="false"/>
  <service android:name="local.artist.engine.PortraitService" android:exported="true" android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
   <intent-filter><action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST"/></intent-filter>
   <meta-data android:name="android.support.wearable.complications.SUPPORTED_TYPES" android:value="LONG_TEXT"/>
   <meta-data android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS" android:value="300"/>
   <meta-data android:name="android.support.wearable.complications.SAFE_WATCH_FACES" android:value="local.artist.watchface.watchfacepush.portrait"/>
  </service>
 </application>
</manifest>
